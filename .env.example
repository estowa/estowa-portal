# タスク更新通知メールの送信設定
# Renderの管理画面 → Environment で以下の環境変数を設定してください

# 会社のメールサーバー(SMTP)のホスト名
SMTP_HOST=smtp.example.com
# ポート番号(SSLの場合は465、STARTTLSの場合は587が一般的)
SMTP_PORT=587
# 465を使う場合は true、587などSTARTTLSの場合は false
SMTP_SECURE=false
# ログイン用のユーザー名(メールアドレスの場合が多い)
SMTP_USER=notify@estowa.jp
# ログイン用のパスワード
SMTP_PASS=your-smtp-password
# 送信元として表示するメールアドレス(未設定の場合はSMTP_USERを使用)
MAIL_FROM=notify@estowa.jp

# メール本文中のリンクに使う、公開されているアプリのURL
APP_BASE_URL=https://estowa-portal.onrender.com
