<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>estowa社内ポータル</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<header class="topbar">
  <div class="topbar-brand">
    <span>estowa社内ポータル</span>
  </div>
</header>
<div class="app-layout">
  <aside class="sidebar">
    <a class="nav-item" href="/" title="ホーム">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/></svg>
      <span class="nav-label">ホーム</span>
    </a>
    <a class="nav-item" href="/tasks" title="タスク管理">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 11h8"/><path d="M7 16h12"/><path d="M7 6h3"/></svg>
      <span class="nav-label">タスク管理</span>
    </a>
    <a class="nav-item" href="/announcements" title="お知らせ">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5.5 2 7.5 2 7.5H4S6 13.5 6 8Z"/><path d="M10.3 20a1.94 1.94 0 0 0 3.4 0"/></svg>
      <span class="nav-label">お知らせ</span>
    </a>
    <a class="nav-item" href="/knowledge" title="ナレッジ共有">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v16"/><path d="M16 13h2"/><path d="M16 9h2"/><path d="M20.001 19A2 2 0 0 0 22 17V5a2 2 0 0 0-1.999-2L16 3.002A5 5 0 0 0 12 5a5 5 0 0 0-4-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 1.999 2H8a5 5 0 0 1 4 2 5 5 0 0 1 4-2z"/><path d="M6 13h2"/><path d="M6 9h2"/></svg>
      <span class="nav-label">ナレッジ共有</span>
    </a>
    <a class="nav-item" href="/sheet-links" title="共有シート">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 14.5 14.5 9.5"/><path d="M11 6.5 12.6 5A4 4 0 0 1 18.3 10.6L16.8 12"/><path d="M13 17.5 11.4 19A4 4 0 0 1 5.7 13.4L7.2 12"/></svg>
      <span class="nav-label">共有シート</span>
    </a>
    <a class="nav-item" href="/sales" title="EC関連">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="21" x2="5" y2="11"/><line x1="12" y1="21" x2="12" y2="6"/><line x1="19" y1="21" x2="19" y2="15"/><line x1="2.5" y1="21" x2="21.5" y2="21"/></svg>
      <span class="nav-label">EC関連</span>
    </a>
    <a class="nav-item" href="/sheets" title="商品粗利表">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="4" x2="9" y2="20"/><line x1="15" y1="4" x2="15" y2="20"/></svg>
      <span class="nav-label">商品粗利表</span>
    </a>
    <a class="nav-item" href="/vendors" title="外注先リスト">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
      <span class="nav-label">外注先リスト</span>
    </a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a class="nav-item" href="/attendance" title="勤怠ダウンロード">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
        <span class="nav-label">勤怠ダウンロード</span>
      </a>
      <a class="nav-item" href="/users" title="ユーザー管理">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6"/><circle cx="17.5" cy="8.5" r="2.4"/><path d="M15.5 14.2c2.7.4 4.5 2.5 4.5 5.3"/></svg>
        <span class="nav-label">ユーザー管理</span>
      </a>
    <% } %>

    <div class="sidebar-footer">
      <% if (currentUser) { %>
        <a href="/profile" class="user-chip-link" title="<%= currentUser.display_name %>（<%= currentUser.role === 'admin' ? '管理者' : 'メンバー' %>）・クリックでアイコン設定">
          <%- include('avatar', { avatar: currentUserAvatar, size: 'md' }) %>
        </a>
        <form method="POST" action="/logout">
          <button type="submit" title="ログアウト">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
          </button>
        </form>
      <% } %>
    </div>
  </aside>

  <main class="main">
