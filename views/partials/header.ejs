<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>estowa社内ポータル</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="app-layout">
  <aside class="sidebar">
    <div class="brand">
      <div class="logo"></div>
      estowa Portal
    </div>

    <a class="nav-item active" href="/">ホーム</a>
    <a class="nav-item" href="#">お知らせ</a>
    <a class="nav-item" href="/tasks">タスク管理</a>
    <a class="nav-item" href="#">外注先リスト</a>
    <a class="nav-item" href="#">売上ダッシュボード</a>
    <a class="nav-item" href="#">グッズ受注管理</a>
    <a class="nav-item" href="#">共有シートリンク集</a>
    <a class="nav-item" href="#">表計算</a>
    <a class="nav-item" href="#">ナレッジ共有</a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a class="nav-item" href="/users">ユーザー管理</a>
    <% } %>

    <div class="sidebar-footer">
      <% if (currentUser) { %>
        <div><%= currentUser.display_name %>（<%= currentUser.role === 'admin' ? '管理者' : 'メンバー' %>）</div>
        <form method="POST" action="/logout">
          <button type="submit">ログアウト</button>
        </form>
      <% } %>
    </div>
  </aside>

  <main class="main">
