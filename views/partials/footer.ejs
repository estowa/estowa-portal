  (function () {
    function setBadge(n) {
      if (!navigator.setAppBadge) return;
      var op = n > 0 ? navigator.setAppBadge(n) : navigator.clearAppBadge();
      if (op && op.catch) op.catch(function () {});
    }
    setBadge(<%= (typeof unreadBadge === 'function' ? Number(unreadBadge()) : 0) || 0 %>);
    // 数字を取り直す。アプリに戻ったときと、タスクのパネルを開いた直後（ページ遷移がないため）に呼ぶ
    function setNavBadges(j) {
      document.querySelectorAll('.nav-badge[data-badge]').forEach(function (el) {
        var n = Number(j[el.dataset.badge]) || 0;
        el.textContent = n > 99 ? '99+' : String(n);
        el.hidden = n <= 0;
      });
      var tb = document.getElementById('menu-toggle-badge');
      if (tb) {
        var t = (Number(j.chat) || 0) + (Number(j.tasks) || 0) + (Number(j.announcements) || 0);
        tb.textContent = t > 99 ? '99+' : String(t);
        tb.hidden = t <= 0;
      }
    }
    window.refreshAppBadge = function () {
      fetch('/badge', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) { if (j) { setBadge(j.count); setNavBadges(j); } })
        .catch(function () {});
    };
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') window.refreshAppBadge();
    });
  })();
</script>
