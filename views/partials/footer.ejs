<script>
  // Service Worker（通知の受信・オフライン案内）。失敗しても画面の動作には影響しない
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
    });
  }
</script>
<script>
  // 「+ 新規登録」系のdetailsを外側クリックで閉じる
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.new-toggle[open]').forEach((el) => {
      if (!el.contains(e.target)) el.removeAttribute('open');
    });
  });

  // data-confirm属性を持つフォームは送信前に確認ダイアログを出す
  // (タスクのスライドインパネル内では別途fetchで処理されるためここでは扱わない)
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (form && form.dataset && form.dataset.confirm) {
      if (!window.confirm(form.dataset.confirm)) {
        e.preventDefault();
      }
    }
  });

  // スマホ: ハンバーガーメニューの開閉
  (function () {
    const btn = document.getElementById('menu-toggle');
    const back = document.getElementById('menu-backdrop');
    if (!btn) return;
    function setOpen(open) {
      document.body.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (back) back.hidden = !open;
    }
    btn.addEventListener('click', () => setOpen(!document.body.classList.contains('menu-open')));
    if (back) back.addEventListener('click', () => setOpen(false));
    document.querySelectorAll('.sidebar a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  })();

  // 現在のページに応じてサイドバーのハイライトを切り替え（ページを入れ替えたあとにも、nav.js が呼ぶ）
  window.updateNavActive = function () {
    const path = window.location.pathname;
    document.querySelectorAll('.sidebar .nav-item').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      const isMatch = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('active', isMatch);
    });
  };
  window.updateNavActive();
</script>
<% if (currentUser) { %><script src="/js/nav.js"></script><% } %>
