  </main>
</div>
<% if (currentUser) { %>
<script>
  // ホーム画面アイコンの赤い数字（未読の合計）。対応していない端末では何もしない
  (function () {
    function setBadge(n) {
      if (!navigator.setAppBadge) return;
      var op = n > 0 ? navigator.setAppBadge(n) : navigator.clearAppBadge();
      if (op && op.catch) op.catch(function () {});
    }
    setBadge(<%= (typeof unreadBadge === 'function' ? Number(unreadBadge()) : 0) || 0 %>);
    // 数字を取り直す。アプリに戻ったときと、タスクのパネルを開いた直後（ページ遷移がないため）に呼ぶ
    function setNavBadges(j) {
      document.querySelectorAll('.nav-badge[data-badge]').forEach(function (el) {
        var n = Number(j[el.dataset.badge]) || 0;
        el.textContent = n > 99 ? '99+' : String(n);
        el.hidden = n <= 0;
      });
    }
    window.refreshAppBadge = function () {
      fetch('/badge', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) { if (j) { setBadge(j.count); setNavBadges(j); } })
        .catch(function () {});
    };
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') window.refreshAppBadge();
    });
  })();
</script>
<% } %>
<script>
  // Service Worker（通知の受信・オフライン案内）。失敗しても画面の動作には影響しない
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
    });
  }
</script>
<script>
  // 「+ 新規登録」系のdetailsを外側クリックで閉じる
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.new-toggle[open]').forEach((el) => {
      if (!el.contains(e.target)) el.removeAttribute('open');
    });
  });

  // data-confirm属性を持つフォームは送信前に確認ダイアログを出す
  // (タスクのスライドインパネル内では別途fetchで処理されるためここでは扱わない)
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (form && form.dataset && form.dataset.confirm) {
      if (!window.confirm(form.dataset.confirm)) {
        e.preventDefault();
      }
    }
  });

  // 現在のページに応じてサイドバーのハイライトを切り替え
  (function () {
    const path = window.location.pathname;
    document.querySelectorAll('.sidebar .nav-item').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      const isMatch = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('active', isMatch);
    });
  })();
</script>
</body>
</html>
