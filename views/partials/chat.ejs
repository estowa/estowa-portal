<div class="panel chat-panel" id="chat-root" hidden>
  <h2 class="has-chip"><span class="h-chip chip-navy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg></span>チャット<span class="chat-total-unread" id="chat-total-unread" hidden></span><button type="button" class="chat-toggle" id="chat-toggle" aria-expanded="true" aria-controls="chat-body">たたむ</button></h2>
  <div class="chat-body" id="chat-body">
  <div class="chat-layout">
    <div class="chat-side">
      <div class="chat-side-head">グループ <button type="button" class="chat-mini-btn" id="chat-new-group">＋ 新規</button></div>
      <ul class="chat-peers" id="chat-groups"></ul>
      <div class="chat-side-head">メンバー</div>
      <ul class="chat-peers" id="chat-peers"></ul>
    </div>
    <div class="chat-thread">
      <div class="chat-thread-head">
        <div class="chat-thread-title" id="chat-title">相手かグループを選んでください</div>
        <button type="button" class="chat-mini-btn" id="chat-group-settings" hidden>グループの設定</button>
      </div>
      <div class="chat-log" id="chat-log"></div>
      <div class="chat-error" id="chat-error" hidden></div>
      <div class="chat-picked" id="chat-picked" hidden></div>
      <form class="chat-form" id="chat-form">
        <label class="chat-attach" title="ファイルや画像を添付（1ファイル10MBまで、5つまで）">
          <input type="file" id="chat-file" multiple hidden />📎
        </label>
        <input type="text" id="chat-input" maxlength="2000" autocomplete="off" placeholder="メッセージを入力" disabled />
        <button type="submit" id="chat-send" disabled>送信</button>
      </form>
    </div>
  </div>
  </div>

  <dialog class="chat-dialog" id="chat-group-dialog">
    <form id="chat-group-form" method="dialog">
      <h3 id="chat-group-dialog-title">グループを作る</h3>
      <label class="chat-dialog-field" id="chat-group-name-field">グループ名（30文字まで）
        <input type="text" id="chat-group-name" maxlength="30" autocomplete="off" />
      </label>
      <div class="chat-dialog-field" id="chat-group-current-wrap" hidden>いまのメンバー
        <div id="chat-group-current" class="chat-group-current"></div>
      </div>
      <div class="chat-dialog-field"><span id="chat-group-pick-label">メンバーを選ぶ</span>
        <div id="chat-group-members" class="chat-group-members"></div>
      </div>
      <div class="chat-error" id="chat-group-error" hidden></div>
      <div class="chat-dialog-actions">
        <button type="button" class="chat-leave-btn" id="chat-group-leave" hidden>このグループから抜ける</button>
        <button type="button" id="chat-group-cancel">閉じる</button>
        <button type="submit" id="chat-group-save" class="chat-primary">作る</button>
      </div>
    </form>
  </dialog>
</div>
<script src="/js/chat.js"></script>
<script>
(function () {
  var body = document.getElementById('chat-body');
  var btn = document.getElementById('chat-toggle');
  var KEY = 'portal.chat.open';
  function saved() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function set(open, remember) {
    body.hidden = !open;
    btn.textContent = open ? 'たたむ' : 'ひらく';
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (remember) { try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (e) {} }
  }
  set(saved() === '1', false);
  btn.addEventListener('click', function () { set(body.hidden, true); });
})();
</script>
