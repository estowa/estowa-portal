<div class="panel chat-panel" id="chat-root" hidden>
  <h2 class="has-chip"><span class="h-chip chip-navy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg></span>チャット・通話<span class="chat-total-unread" id="chat-total-unread" hidden></span><button type="button" class="chat-toggle" id="chat-toggle" aria-expanded="true" aria-controls="chat-body">たたむ</button></h2>
  <div class="chat-body" id="chat-body">
  <div class="voice-bar">
    <button type="button" id="voice-enable" class="voice-enable">音声ON</button>
    <label class="voice-volume">音量 <input type="range" id="voice-volume" min="0" max="100" value="80" /></label>
    <button type="button" id="voice-mute" class="voice-mute" aria-pressed="false">消音</button>
    <span class="voice-note" id="voice-note">先に「音声ON」を押してください。PCのミュートを解除し、音量を上げておいてください。</span>
  </div>
  <div class="voice-speaking" id="voice-speaking" hidden></div>
  <div class="voice-error" id="voice-error" hidden></div>
  <div class="chat-layout">
    <ul class="chat-peers" id="chat-peers"></ul>
    <div class="chat-thread">
      <div class="chat-thread-title" id="chat-title">相手を選んでください</div>
      <div class="chat-log" id="chat-log"></div>
      <div class="chat-error" id="chat-error" hidden></div>
      <form class="chat-form" id="chat-form">
        <input type="text" id="chat-input" maxlength="2000" autocomplete="off" placeholder="メッセージを入力" disabled />
        <button type="submit" id="chat-send" disabled>送信</button>
      </form>
    </div>
  </div>
  </div>
</div>
<script src="/js/chat.js"></script>
<script src="/js/voice.js"></script>
<script>
(function () {
  var root = document.getElementById('chat-root');
  var body = document.getElementById('chat-body');
  var btn = document.getElementById('chat-toggle');
  var badge = document.getElementById('chat-total-unread');
  var KEY = 'portal.chat.open';
  function saved() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function set(open, remember) {
    body.hidden = !open;
    btn.textContent = open ? 'たたむ' : 'ひらく';
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (remember) { try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (e) {} }
  }
  function updateBadge() {
    var n = 0;
    root.querySelectorAll('.chat-unread').forEach(function (el) { n += parseInt(el.textContent, 10) || 1; });
    badge.textContent = n + '件の未読';
    badge.hidden = n === 0;
  }
  set(saved() === '1', false);
  btn.addEventListener('click', function () { set(body.hidden, true); });
  new MutationObserver(updateBadge).observe(document.getElementById('chat-peers'), { childList: true, subtree: true, characterData: true });
  updateBadge();
})();
</script>
