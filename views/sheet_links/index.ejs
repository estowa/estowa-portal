<%- include('../partials/header') %>

<div class="page-header">
  <h1>共有シート</h1>
  <details class="new-toggle">
    <summary>+ 新規登録</summary>
    <div class="new-form-panel">
      <h2>新規登録</h2>
      <form method="POST" action="/sheet-links">
        <input type="text" name="title" placeholder="タイトル" required />
        <input type="url" name="url" placeholder="https://..." required />
        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">追加</button>
      </form>
    </div>
  </details>
</div>

<div class="panel">
  <% if (links.length === 0) { %>
    <div class="empty-note">登録されているリンクはありません</div>
  <% } else { %>
    <div class="link-card-grid">
      <% links.forEach(l => { %>
        <div class="link-card">
          <a href="<%= l.url %>" target="_blank" rel="noopener" class="link-card-title"><%= l.title %></a>
          <form method="POST" action="/sheet-links/<%= l.id %>/delete" class="link-card-delete" onsubmit="return confirm('削除しますか？');">
            <button type="submit" class="mini-btn">削除</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
