<%- include('partials/header') %>

<div class="kpi-grid">
  <div class="kpi-card has-chip">
    <span class="chip chip-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m7 15 4-4 3 3 5-6"/></svg></span>
    <div class="kpi-body">
    <div class="label">今月のEC売上</div>
    <% if (salesSummary.monthlyTotal === null) { %>
      <div class="value placeholder">データがまだありません</div>
    <% } else { %>
      <div class="value">¥<%= salesSummary.monthlyTotal.toLocaleString() %></div>
    <% } %>
    </div>
  </div>
  <div class="kpi-card has-chip">
    <span class="chip chip-lavender"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5.5 2 7.5 2 7.5H4S6 13.5 6 8Z"/><path d="M10.3 20a1.94 1.94 0 0 0 3.4 0"/></svg></span>
    <div class="kpi-body">
    <div class="label">未読お知らせ</div>
    <div class="value"><%= unreadAnnouncementCount %> 件</div>
    </div>
  </div>
  <div class="kpi-card has-chip">
    <span class="chip chip-coral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8.5 10 2 2 4-4"/><path d="M8.5 16h7"/></svg></span>
    <div class="kpi-body">
    <div class="label">自分の未完了タスク</div>
    <div class="value"><%= myTasks.length %> 件</div>
    </div>
  </div>
  <div class="kpi-card has-chip">
    <span class="chip chip-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
    <div class="kpi-body">
    <% if (user.role === 'admin') { %>
      <div class="label">本日の出勤状況</div>
      <div class="value" style="font-size:16px;">
        出勤中 <%= teamAttendanceToday.filter(t => t.status === 'in').length %>名 /
        未出勤 <%= teamAttendanceToday.filter(t => t.status === 'none').length %>名
      </div>
    <% } else { %>
      <div class="label">本日の勤怠</div>
      <div class="value" style="font-size:16px;"><%= isCheckedIn ? '出勤中' : '未出勤 / 退勤済' %></div>
    <% } %>
    </div>
  </div>
</div>

<div class="content-grid">
  <div>
    <%- include('partials/chat') %>

    <div class="panel">
      <h2 class="has-chip"><span class="h-chip chip-lavender"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5.5 2 7.5 2 7.5H4S6 13.5 6 8Z"/><path d="M10.3 20a1.94 1.94 0 0 0 3.4 0"/></svg></span>お知らせ <a href="/announcements" style="font-size:12px; font-weight:400; color:var(--primary); margin-left:auto;">すべて見る →</a></h2>
      <% if (announcements.length === 0) { %>
        <div class="empty-note">現在お知らせはありません</div>
      <% } else { %>
        <% announcements.forEach(a => { %>
          <div class="announcement-item">
            <a href="/announcements/<%= a.id %>" class="link-title"><%= a.title %></a>
            <div style="color:#6b7080; font-size:13px;"><%= a.body %></div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="panel">
      <h2 class="has-chip"><span class="h-chip chip-coral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8.5 10 2 2 4-4"/><path d="M8.5 16h7"/></svg></span>直近の個人タスク</h2>
      <% if (myTasks.length === 0) { %>
        <div class="empty-note">未完了のタスクはありません</div>
      <% } else { %>
        <% myTasks.forEach(t => { %>
          <div class="task-item">
            <a href="/tasks/<%= t.id %>" class="link-title"><%= t.title %></a>
            <% if (t.due_at) { %><span style="color:#6b7080; font-size:12px;"> - 期限: <%= t.due_at.replace('T', ' ') %></span><% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div>
    <div class="panel">
      <% if (user.role === 'admin') { %>
        <h2 class="has-chip"><span class="h-chip chip-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>本日のメンバー出勤状況</h2>
        <% if (teamAttendanceToday.length === 0) { %>
          <div class="empty-note">メンバーが登録されていません</div>
        <% } else { %>
          <div class="team-attendance-list">
            <% teamAttendanceToday.forEach(t => { %>
              <div class="team-attendance-row">
                <span><%= t.name %></span>
                <span class="badge attendance-badge-<%= t.status %>"><%= t.label %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <h2 class="has-chip"><span class="h-chip chip-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>勤怠</h2>
        <div class="attendance-box">
          <div class="attendance-status"><%= isCheckedIn ? '現在: 出勤中' : '現在: 未出勤' %></div>
          <form method="POST" action="/attendance/punch">
            <button type="submit" class="attendance-btn <%= isCheckedIn ? 'checkout' : 'checkin' %>">
              <%= isCheckedIn ? '退勤する' : '出勤する' %>
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <h2 class="has-chip" style="margin:0;"><span class="h-chip chip-rose"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M3 10h18"/></svg></span>イベントカレンダー</h2>
        <div style="display:flex; gap:6px;">
          <a href="/?cal_year=<%= calPrevYear %>&cal_month=<%= calPrevMonth %>" class="mini-btn">←</a>
          <a href="/?cal_year=<%= calNextYear %>&cal_month=<%= calNextMonth %>" class="mini-btn">→</a>
        </div>
      </div>
      <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;"><%= calYear %>年<%= calMonth %>月</div>

      <div class="calendar-grid calendar-grid-mini">
        <% ['日','月','火','水','木','金','土'].forEach(d => { %>
          <div class="calendar-weekday"><%= d %></div>
        <% }) %>

        <% for (let i = 0; i < calFirstWeekday; i++) { %>
          <div class="calendar-cell empty"></div>
        <% } %>

        <% for (let day = 1; day <= calLastDay; day++) { %>
          <div class="calendar-cell">
            <div class="calendar-day"><%= day %></div>
            <% if (calEventsByDay[day]) { %>
              <% calEventsByDay[day].forEach(ev => { %>
                <div class="event-chip <%= eventCategoryClass(ev.category) %>" title="<%= ev.title %>"><%= ev.title %></div>
              <% }) %>
            <% } %>
          </div>
        <% } %>
      </div>
      <div style="font-size:12px; color:var(--text-muted); margin-top:10px;">追加・編集は<a href="/sales#events" style="color:var(--primary);">EC関連ページ</a>から行えます。</div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
