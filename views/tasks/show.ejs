<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1><%= task.title %></h1>
    <% if (updatedByName && task.updated_at) { %>
      <div class="updated-by-line" style="font-size:12px; color:var(--text-muted); margin-top:4px;">
        最終更新:
        <% if (updatedByAvatar) { %>
          <%- include('../partials/avatar', { avatar: updatedByAvatar, size: 'xs' }) %>
        <% } %>
        <%= updatedByName %>（<%= task.updated_at.slice(0, 16).replace('T', ' ') %>）
      </div>
    <% } %>
  </div>
  <a href="/tasks" class="mini-btn">← 一覧に戻る</a>
</div>

<div class="content-grid">
  <div>
    <div class="panel">
      <h2>タスク内容の編集</h2>
      <% if (error) { %><div class="error-text"><%= error %></div><% } %>
      <form method="POST" action="/tasks/<%= task.id %>">
        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">タスク内容</label>
        <input type="text" name="title" value="<%= task.title %>" required
          style="width:100%; padding:10px; margin-bottom:10px; border:1px solid var(--border); border-radius:8px;" />

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">概要</label>
        <textarea name="description" rows="5" placeholder="タスクの詳細・背景・メモなど"
          style="width:100%; padding:10px; margin-bottom:10px; border:1px solid var(--border); border-radius:8px; font-family:inherit; font-size:14px; resize:vertical;"><%= task.description || '' %></textarea>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">ステータス</label>
        <select name="status" style="width:100%; padding:10px; margin-bottom:10px; border:1px solid var(--border); border-radius:8px;">
          <% statusDefs.forEach(([key, label]) => { %>
            <option value="<%= key %>" <%= task.status === key ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">締切日時（任意）</label>
        <div class="form-inline" style="margin-bottom:10px;">
          <input type="date" name="due_date" value="<%= task.due_at ? task.due_at.split('T')[0] : '' %>" style="flex:1;" />
          <input type="time" name="due_time" value="<%= task.due_at ? task.due_at.split('T')[1] : '18:00' %>" style="width:110px;" />
        </div>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">開始日時（任意）</label>
        <div class="form-inline" style="margin-bottom:10px;">
          <input type="date" name="start_date" value="<%= task.start_date || '' %>" style="flex:1;" />
          <input type="time" name="start_time" value="<%= task.start_time || '09:00' %>" style="width:110px;" />
        </div>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin:8px 0 4px;">担当者（メンバー管理・複数選択可）</label>
        <div class="assignee-checklist" style="margin-bottom:12px;">
          <% users.forEach(u => { %>
            <label class="assignee-check assignee-check-icon">
              <input type="checkbox" name="assignee_ids" value="<%= u.user_id %>" <%= assignedIds.has(u.user_id) ? 'checked' : '' %> />
              <%- include('../partials/avatar', { avatar: u.avatar, size: 'xs' }) %>
              <%= u.display_name %>
            </label>
          <% }) %>
        </div>

        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">保存する</button>
      </form>
    </div>

    <div class="panel">
      <h2>やり取り（コメント・添付ファイル）</h2>
      <% if (uploadError) { %><div class="error-text"><%= uploadError %></div><% } %>

      <% if (timeline.length === 0) { %>
        <div class="empty-note">まだコメントや添付ファイルはありません</div>
      <% } else { %>
        <div class="timeline">
          <% timeline.forEach(item => { %>
            <div class="timeline-item">
              <div class="timeline-item-head">
                <span class="name">
                  <%- include('../partials/avatar', { avatar: item.avatar, size: 'xs' }) %>
                  <%= item.userName %>
                </span>
                <span><%= item.createdAt.slice(0, 16).replace('T', ' ') %></span>
              </div>
              <% if (item.body) { %>
                <div class="timeline-item-body"><%= item.body %></div>
              <% } %>
              <% if (item.attachments.length > 0) { %>
                <div class="attachment-grid">
                  <% item.attachments.forEach(a => { %>
                    <div class="attachment-item">
                      <% if (a.mime_type && a.mime_type.startsWith('image/')) { %>
                        <a href="/uploads/tasks/<%= a.filename %>" target="_blank" rel="noopener">
                          <img src="/uploads/tasks/<%= a.filename %>" alt="<%= a.original_name %>" />
                        </a>
                      <% } else { %>
                        <a href="/uploads/tasks/<%= a.filename %>" target="_blank" rel="noopener" class="attachment-file-link">
                          <div class="attachment-file-icon">📄</div>
                        </a>
                      <% } %>
                      <div class="attachment-name" title="<%= a.original_name %>"><%= a.original_name %></div>
                      <form method="POST" action="/tasks/<%= task.id %>/attachments/<%= a.id %>/delete" onsubmit="return confirm('このファイルを削除しますか？');">
                        <button type="submit" class="mini-btn">削除</button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              <% } %>
              <% if (item.type === 'comment') { %>
                <form method="POST" action="/tasks/<%= task.id %>/comments/<%= item.id %>/delete" onsubmit="return confirm('このコメントを削除しますか？');">
                  <button type="submit" class="mini-btn">削除</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <form method="POST" action="/tasks/<%= task.id %>/comments" enctype="multipart/form-data" class="comment-composer">
        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">コメントを追加</label>
        <textarea name="body" rows="3" placeholder="やり取りの内容を入力"></textarea>

        <div class="dropzone" style="margin-bottom:12px;">
          <input type="file" name="files" multiple />
          <div>ここにファイルをドラッグ&ドロップ<br />またはクリックして選択</div>
          <div class="dropzone-filelist"></div>
        </div>

        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">送信する</button>
      </form>
    </div>
  </div>

  <div>
    <div class="panel">
      <h2>タスクを削除</h2>
      <p style="font-size:13px; color:var(--text-muted);">このタスクと添付ファイルを完全に削除します。</p>
      <form method="POST" action="/tasks/<%= task.id %>/delete" onsubmit="return confirm('このタスクを削除しますか？元に戻せません。');">
        <button type="submit" class="mini-btn">タスクを削除する</button>
      </form>
    </div>
  </div>
</div>

<script src="/js/dropzone.js"></script>
<%- include('../partials/footer') %>
