<div class="page-header">
  <div style="display:flex; align-items:center; gap:14px;">
    <h1>タスク管理</h1>
    <div class="task-view-tabs">
      <button type="button" class="task-view-tab <%= view !== 'calendar' ? 'active' : '' %>" data-view="board">ボード</button>
      <button type="button" class="task-view-tab <%= view === 'calendar' ? 'active' : '' %>" data-view="calendar">カレンダー</button>
    </div>
    <% if (taskBoard === 'project') { %>
      <a href="/tasks?view=<%= view %>" class="project-toggle-btn" style="margin-left:10px;">社内全体タスク</a>
    <% } else { %>
      <a href="/tasks?board=project&view=<%= view %>" class="project-toggle-btn" style="margin-left:10px;">プロジェクト</a>
    <% } %>
  </div>
  <a href="/tasks/new?board=<%= taskBoard %>" class="new-toggle-btn">+ 新規タスク</a>
</div>

<div id="board-view" style="<%= view === 'calendar' ? 'display:none;' : '' %>">
<div class="kanban-grid">
  <% statusDefs.forEach(([key, label]) => { %>
    <div class="kanban-column" data-status="<%= key %>">
      <h3><%= label %> <span class="count">(<%= board[key].length %>)</span></h3>
      <div class="kanban-list" data-status="<%= key %>">
        <% board[key].forEach(t => { %>
          <a href="/tasks/<%= t.id %>" class="kanban-card" data-id="<%= t.id %>">
            <div class="kanban-card-title"><%= t.title %></div>
            <div class="kanban-card-meta">
              <div class="assignee-inline">
                <% if (t.assignees.length === 0) { %>
                  <span class="names">未割当</span>
                <% } else { %>
                  <span class="avatar-group">
                    <% t.assignees.forEach(a => { %>
                      <span title="<%= a.display_name %>"><%- include('../partials/avatar', { avatar: a.avatar, size: 'xs' }) %></span>
                    <% }) %>
                  </span>
                  <span class="names"><%= t.assigneeNames %></span>
                <% } %>
              </div>
              <% if (t.due_at) { %><div><%= t.due_at.replace('T', ' ') %></div><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>
</div>
<!-- /#board-view -->

<div id="calendar-view" style="<%= view === 'calendar' ? '' : 'display:none;' %>">
<div class="panel">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <a href="/tasks?year=<%= prevYear %>&month=<%= prevMonth %>&view=calendar&board=<%= taskBoard %>" class="mini-btn">← 前月</a>
    <h2 style="margin:0;"><%= year %>年<%= month %>月</h2>
    <a href="/tasks?year=<%= nextYear %>&month=<%= nextMonth %>&view=calendar&board=<%= taskBoard %>" class="mini-btn">次月 →</a>
  </div>

  <div class="calendar-grid">
    <% ['日','月','火','水','木','金','土'].forEach(d => { %>
      <div class="calendar-weekday"><%= d %></div>
    <% }) %>

    <% for (let i = 0; i < firstWeekday; i++) { %>
      <div class="calendar-cell empty"></div>
    <% } %>

    <% for (let day = 1; day <= lastDay; day++) { %>
      <% const dayStr = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`; %>
      <a class="calendar-cell" href="/tasks/day/<%= dayStr %>?board=<%= taskBoard %>">
        <div class="calendar-day"><%= day %></div>
        <% if (tasksByDay[day]) { %>
          <% tasksByDay[day].forEach(t => { %>
            <div class="calendar-task" title="<%= t.assigneeNames %>">
              <% if (t.assignees.length > 0) { %>
                <span style="font-size:9px;"><%- include('../partials/avatar', { avatar: t.assignees[0].avatar, size: 'xs' }) %></span>
              <% } %>
              <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= t.title %></span>
            </div>
          <% }) %>
        <% } %>
      </a>
    <% } %>
  </div>
</div>
</div>
<!-- /#calendar-view -->
