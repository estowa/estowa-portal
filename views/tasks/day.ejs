<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= date %> のタスク</h1>
  <a href="/tasks?board=<%= taskBoard %>" class="mini-btn">← タスク管理に戻る</a>
</div>

<div class="panel">
  <% if (tasks.length === 0) { %>
    <div class="empty-note">この日のタスクはありません</div>
  <% } else { %>
    <% tasks.forEach(t => { %>
      <a href="/tasks/<%= t.id %>" class="task-item" style="display:block;">
        <strong><%= t.title %></strong>
        <div class="assignee-inline" style="margin-top:4px;">
          <% if (t.assignees.length === 0) { %>
            <span class="names" style="color:var(--text-muted); font-size:12px;">未割当</span>
          <% } else { %>
            <span class="avatar-group">
              <% t.assignees.forEach(a => { %>
                <span title="<%= a.display_name %>"><%- include('../partials/avatar', { avatar: a.avatar, size: 'xs' }) %></span>
              <% }) %>
            </span>
            <span class="names" style="color:var(--text-muted); font-size:12px;"><%= t.assigneeNames %></span>
          <% } %>
        </div>
        <div style="color:var(--text-muted); font-size:12px; margin-top:2px;">
          <% if (t.start_date) { %>開始: <%= t.start_date %><%= t.start_time ? ' ' + t.start_time : '' %><% } %>
          <% if (t.start_date && t.due_at) { %> ・ <% } %>
          <% if (t.due_at) { %>締切: <%= t.due_at.replace('T', ' ') %><% } %>
        </div>
      </a>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
