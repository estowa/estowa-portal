<%- include('../partials/header') %>

<div id="tasks-board-root">
<%- include('_board_content') %>
</div>

<!-- タスクの登録・編集画面(一覧の右側からスライドインするパネル) -->
<div id="task-detail-panel" class="task-detail-panel">
  <button type="button" id="task-panel-close" class="task-panel-close" aria-label="閉じる">×</button>
  <div id="task-panel-body"></div>
</div>

<script src="/js/dropzone.js"></script>
<script>
(function () {
  const root = document.getElementById('tasks-board-root');
  const panel = document.getElementById('task-detail-panel');
  const panelBody = document.getElementById('task-panel-body');
  const closeBtn = document.getElementById('task-panel-close');

  // ---------- スライドインパネル(タスクの登録・編集) ----------
  function openPanelFromUrl(url) {
    fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
      .then((res) => res.text())
      .then((html) => {
        panelBody.innerHTML = html;
        panel.classList.add('open');
        if (window.initDropzones) window.initDropzones(panelBody);
      });
  }

  function closePanel() {
    panel.classList.remove('open');
  }

  function refreshBoard() {
    fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch' } })
      .then((res) => res.text())
      .then((html) => {
        root.innerHTML = html;
      });
  }

  // タスクカード・新規タスクボタンのクリックはページ遷移せずパネルを開く
  // (ボード/カレンダーのタブ切り替えも委譲イベントでここにまとめている)
  root.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey) return; // 新しいタブで開く操作はブラウザ標準に任せる

    const card = e.target.closest('.kanban-card');
    if (card) {
      e.preventDefault();
      if (card.dataset.justDragged === '1') {
        card.dataset.justDragged = '';
        return;
      }
      openPanelFromUrl(card.getAttribute('href'));
      return;
    }

    const newBtn = e.target.closest('.new-toggle-btn');
    if (newBtn) {
      e.preventDefault();
      openPanelFromUrl(newBtn.getAttribute('href'));
      return;
    }

    const tab = e.target.closest('.task-view-tab');
    if (tab) {
      const tabs = root.querySelectorAll('.task-view-tab');
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const view = tab.dataset.view;
      const boardView = document.getElementById('board-view');
      const calendarView = document.getElementById('calendar-view');
      boardView.style.display = view === 'calendar' ? 'none' : '';
      calendarView.style.display = view === 'calendar' ? '' : 'none';

      const url = new URL(window.location);
      url.searchParams.set('view', view);
      window.history.replaceState({}, '', url);
      return;
    }
  });

  // 一覧の何もないところ(カード・新規タスクボタン・パネル以外)をクリックしたらパネルを閉じる
  document.addEventListener('click', (e) => {
    if (!panel.classList.contains('open')) return;
    if (panel.contains(e.target)) return;
    if (e.target.closest('.kanban-card')) return;
    if (e.target.closest('.new-toggle-btn')) return;
    closePanel();
  });

  closeBtn.addEventListener('click', closePanel);

  // パネル内のフォーム送信をfetchで処理し、ページ遷移させずに結果を反映する
  panelBody.addEventListener('submit', (e) => {
    const form = e.target;
    if (form.tagName !== 'FORM') return;
    e.preventDefault();
    e.stopPropagation();

    if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) {
      return;
    }

    const isMultipart = form.enctype === 'multipart/form-data';
    const formData = new FormData(form);
    const fetchOptions = {
      method: form.getAttribute('method') || 'POST',
      headers: { 'X-Requested-With': 'fetch' },
    };
    if (isMultipart) {
      fetchOptions.body = formData;
    } else {
      // multerを使わないフォーム(タイトル・ステータス編集など)はurlencodedで送る
      fetchOptions.headers['Content-Type'] = 'application/x-www-form-urlencoded';
      fetchOptions.body = new URLSearchParams(formData).toString();
    }

    fetch(form.getAttribute('action'), fetchOptions)
      .then(async (res) => {
        const contentType = res.headers.get('content-type') || '';
        if (contentType.indexOf('application/json') !== -1) {
          const data = await res.json();
          if (data.redirect) {
            if (/^\/tasks\/\d+/.test(data.redirect)) {
              openPanelFromUrl(data.redirect);
            } else {
              closePanel();
            }
            refreshBoard();
          }
        } else {
          // バリデーションエラーなどはパネルの中身をそのまま差し替える
          const html = await res.text();
          panelBody.innerHTML = html;
          if (window.initDropzones) window.initDropzones(panelBody);
        }
      })
      .catch(() => {});
  });

  // ---------- カンバンのドラッグ&ドロップでステータス変更 ----------
  // (HTML5のネイティブDrag&Dropはリンク要素とiOS Safariの相性が悪く、
  //  タッチ操作でうまく動作しないためPointer Eventsで自前実装している。
  //  パネル表示の追加に伴い、一覧の再描画後も動作するよう委譲イベントで実装)
  const THRESHOLD = 8; // これ以上動いたらドラッグとみなす(px)
  let downX = 0, downY = 0, dragging = false, activeCard = null;
  let clone = null, offsetX = 0, offsetY = 0, originalList = null;

  function findListUnder(x, y) {
    const el = document.elementFromPoint(x, y);
    return el ? el.closest('.kanban-list') : null;
  }

  function clearDragOver() {
    document.querySelectorAll('.kanban-list.drag-over').forEach((el) => el.classList.remove('drag-over'));
  }

  // 列見出しの件数(◯件)を、実際に表示されているカード数に合わせて更新する
  function updateColumnCount(list) {
    if (!list) return;
    const column = list.closest('.kanban-column');
    if (!column) return;
    const countEl = column.querySelector('.count');
    if (countEl) countEl.textContent = '(' + list.querySelectorAll('.kanban-card').length + ')';
  }

  root.addEventListener('pointerdown', (e) => {
    const card = e.target.closest('.kanban-card');
    if (!card) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    activeCard = card;
    downX = e.clientX;
    downY = e.clientY;
    dragging = false;
    card.setPointerCapture(e.pointerId);
  });

  root.addEventListener('pointermove', (e) => {
    if (!activeCard || !activeCard.hasPointerCapture || !activeCard.hasPointerCapture(e.pointerId)) return;

    if (!dragging) {
      const dx = e.clientX - downX;
      const dy = e.clientY - downY;
      if (Math.hypot(dx, dy) < THRESHOLD) return;

      dragging = true;
      const rect = activeCard.getBoundingClientRect();
      offsetX = downX - rect.left;
      offsetY = downY - rect.top;
      originalList = activeCard.closest('.kanban-list');

      clone = activeCard.cloneNode(true);
      clone.classList.add('kanban-card-dragging-clone');
      clone.style.position = 'fixed';
      clone.style.left = rect.left + 'px';
      clone.style.top = rect.top + 'px';
      clone.style.width = rect.width + 'px';
      document.body.appendChild(clone);
      activeCard.classList.add('kanban-card-placeholder');
    }

    e.preventDefault();
    clone.style.left = (e.clientX - offsetX) + 'px';
    clone.style.top = (e.clientY - offsetY) + 'px';

    clearDragOver();
    const target = findListUnder(e.clientX, e.clientY);
    if (target) target.classList.add('drag-over');
  });

  async function finishDrag(e) {
    if (!activeCard || !dragging) { activeCard = null; return; }
    e.preventDefault();
    dragging = false;
    activeCard.dataset.justDragged = '1'; // 直後に発火するclickイベントでパネルを開かせないためのフラグ
    clearDragOver();
    if (clone) clone.remove();
    activeCard.classList.remove('kanban-card-placeholder');

    const targetList = findListUnder(e.clientX, e.clientY);
    const card = activeCard;
    activeCard = null;

    if (targetList && targetList !== originalList) {
      const status = targetList.dataset.status;

      // ページ全体をリロードせず、カード自体を移動先の列にすぐ移す
      // (体感を良くするため。失敗した場合は元の列に戻す)
      targetList.appendChild(card);
      updateColumnCount(originalList);
      updateColumnCount(targetList);

      try {
        const res = await fetch('/tasks/' + card.dataset.id + '/status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'fetch',
          },
          body: 'status=' + status,
        });
        if (!res.ok) throw new Error('status update failed');
      } catch (err) {
        // 失敗時は元の列に戻す
        originalList.appendChild(card);
        updateColumnCount(originalList);
        updateColumnCount(targetList);
      }
    }
  }

  root.addEventListener('pointerup', finishDrag);
  root.addEventListener('pointercancel', () => {
    if (clone) clone.remove();
    if (activeCard) activeCard.classList.remove('kanban-card-placeholder');
    clearDragOver();
    dragging = false;
    activeCard = null;
  });
})();
</script>

<%- include('../partials/footer') %>
