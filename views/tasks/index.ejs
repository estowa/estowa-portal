<%- include('../partials/header') %>

<div class="page-header">
  <h1>タスク管理</h1>
  <a href="/tasks/new" class="new-toggle-btn">+ 新規タスク</a>
</div>

<div class="kanban-grid">
  <% statusDefs.forEach(([key, label]) => { %>
    <div class="kanban-column" data-status="<%= key %>">
      <h3><%= label %> <span class="count">(<%= board[key].length %>)</span></h3>
      <div class="kanban-list" data-status="<%= key %>">
        <% board[key].forEach(t => { %>
          <a href="/tasks/<%= t.id %>" class="kanban-card" data-id="<%= t.id %>">
            <div class="kanban-card-title"><%= t.title %></div>
            <div class="kanban-card-meta">
              <%= t.assigneeNames || '未割当' %>
              <% if (t.due_at) { %> ・ <%= t.due_at.replace('T', ' ') %><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<div class="panel" style="margin-top:20px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <a href="/tasks?year=<%= prevYear %>&month=<%= prevMonth %>" class="mini-btn">← 前月</a>
    <h2 style="margin:0;"><%= year %>年<%= month %>月</h2>
    <a href="/tasks?year=<%= nextYear %>&month=<%= nextMonth %>" class="mini-btn">次月 →</a>
  </div>

  <div class="calendar-grid">
    <% ['日','月','火','水','木','金','土'].forEach(d => { %>
      <div class="calendar-weekday"><%= d %></div>
    <% }) %>

    <% for (let i = 0; i < firstWeekday; i++) { %>
      <div class="calendar-cell empty"></div>
    <% } %>

    <% for (let day = 1; day <= lastDay; day++) { %>
      <% const dayStr = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`; %>
      <a class="calendar-cell" href="/tasks/day/<%= dayStr %>">
        <div class="calendar-day"><%= day %></div>
        <% if (tasksByDay[day]) { %>
          <% tasksByDay[day].forEach(t => { %>
            <div class="calendar-task" title="<%= t.assigneeNames %>"><%= t.title %></div>
          <% }) %>
        <% } %>
      </a>
    <% } %>
  </div>
</div>

<script>
  // カンバンのドラッグ&ドロップでステータス変更
  // (HTML5のネイティブDrag&Dropはリンク要素とiOS Safariの相性が悪く、
  //  タッチ操作でうまく動作しないためPointer Eventsで自前実装している)
  (function () {
    const THRESHOLD = 8; // これ以上動いたらドラッグとみなす(px)

    function findListUnder(x, y) {
      const el = document.elementFromPoint(x, y);
      return el ? el.closest('.kanban-list') : null;
    }

    function clearDragOver() {
      document.querySelectorAll('.kanban-list.drag-over').forEach((el) => el.classList.remove('drag-over'));
    }

    document.querySelectorAll('.kanban-card').forEach((card) => {
      let downX = 0;
      let downY = 0;
      let dragging = false;
      let justDragged = false;
      let clone = null;
      let offsetX = 0;
      let offsetY = 0;
      let originalList = null;

      card.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        downX = e.clientX;
        downY = e.clientY;
        dragging = false;
        card.setPointerCapture(e.pointerId);
      });

      card.addEventListener('pointermove', (e) => {
        if (!card.hasPointerCapture || !card.hasPointerCapture(e.pointerId)) return;

        if (!dragging) {
          const dx = e.clientX - downX;
          const dy = e.clientY - downY;
          if (Math.hypot(dx, dy) < THRESHOLD) return;

          dragging = true;
          const rect = card.getBoundingClientRect();
          offsetX = downX - rect.left;
          offsetY = downY - rect.top;
          originalList = card.closest('.kanban-list');

          clone = card.cloneNode(true);
          clone.classList.add('kanban-card-dragging-clone');
          clone.style.position = 'fixed';
          clone.style.left = rect.left + 'px';
          clone.style.top = rect.top + 'px';
          clone.style.width = rect.width + 'px';
          document.body.appendChild(clone);
          card.classList.add('kanban-card-placeholder');
        }

        e.preventDefault();
        clone.style.left = (e.clientX - offsetX) + 'px';
        clone.style.top = (e.clientY - offsetY) + 'px';

        clearDragOver();
        const target = findListUnder(e.clientX, e.clientY);
        if (target) target.classList.add('drag-over');
      });

      async function finishDrag(e) {
        if (!dragging) return;
        e.preventDefault();
        dragging = false;
        justDragged = true; // 直後に発火するclickイベントで遷移させないためのフラグ
        clearDragOver();
        if (clone) clone.remove();
        card.classList.remove('kanban-card-placeholder');

        const targetList = findListUnder(e.clientX, e.clientY);
        if (targetList && targetList !== originalList) {
          const status = targetList.dataset.status;
          await fetch('/tasks/' + card.dataset.id + '/status', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-Requested-With': 'fetch',
            },
            body: 'status=' + status,
          });
          window.location.reload();
        }
      }

      card.addEventListener('pointerup', finishDrag);
      card.addEventListener('pointercancel', () => {
        if (clone) clone.remove();
        card.classList.remove('kanban-card-placeholder');
        clearDragOver();
        dragging = false;
      });

      // ドラッグした直後はクリック(詳細ページへの遷移)を打ち消す
      card.addEventListener('click', (e) => {
        if (justDragged) {
          e.preventDefault();
          justDragged = false;
        }
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
