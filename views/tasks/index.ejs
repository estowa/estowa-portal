<%- include('../partials/header') %>

<div class="page-header">
  <h1>タスク管理</h1>
  <details class="new-toggle">
    <summary>+ 新規タスク</summary>
    <div class="new-form-panel" style="min-width:280px;">
      <h2>新規タスク追加</h2>
      <form method="POST" action="/tasks">
        <input type="text" name="title" placeholder="タスク内容" required />

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">概要（任意）</label>
        <textarea name="description" rows="3" placeholder="詳細・背景・メモなど"
          style="width:100%; margin-bottom:8px; padding:8px; border:1px solid var(--border); border-radius:6px; font-family:inherit; font-size:13px; resize:vertical;"></textarea>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">締切日時（必須）</label>
        <div class="form-inline" style="margin-bottom:8px;">
          <input type="date" name="due_date" required style="flex:1;" />
          <input type="time" name="due_time" value="18:00" style="width:110px;" />
        </div>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">開始日（任意）</label>
        <input type="date" name="start_date" />

        <label style="font-size:12px; color:var(--text-muted); display:block; margin:8px 0 2px;">担当者（複数選択可）</label>
        <div class="assignee-checklist">
          <% users.forEach(u => { %>
            <label class="assignee-check">
              <input type="checkbox" name="assignee_ids" value="<%= u.user_id %>" />
              <%= u.display_name %>
            </label>
          <% }) %>
        </div>

        <button type="submit" style="margin-top:10px; padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">追加</button>
      </form>
    </div>
  </details>
</div>

<div class="kanban-grid">
  <% statusDefs.forEach(([key, label]) => { %>
    <div class="kanban-column" data-status="<%= key %>">
      <h3><%= label %> <span class="count">(<%= board[key].length %>)</span></h3>
      <div class="kanban-list" data-status="<%= key %>">
        <% board[key].forEach(t => { %>
          <a href="/tasks/<%= t.id %>" class="kanban-card" draggable="true" data-id="<%= t.id %>">
            <div class="kanban-card-title"><%= t.title %></div>
            <div class="kanban-card-meta">
              <%= t.assigneeNames || '未割当' %>
              <% if (t.due_at) { %> ・ <%= t.due_at.replace('T', ' ') %><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<div class="panel" style="margin-top:20px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <a href="/tasks?year=<%= prevYear %>&month=<%= prevMonth %>" class="mini-btn">← 前月</a>
    <h2 style="margin:0;"><%= year %>年<%= month %>月</h2>
    <a href="/tasks?year=<%= nextYear %>&month=<%= nextMonth %>" class="mini-btn">次月 →</a>
  </div>

  <div class="calendar-grid">
    <% ['日','月','火','水','木','金','土'].forEach(d => { %>
      <div class="calendar-weekday"><%= d %></div>
    <% }) %>

    <% for (let i = 0; i < firstWeekday; i++) { %>
      <div class="calendar-cell empty"></div>
    <% } %>

    <% for (let day = 1; day <= lastDay; day++) { %>
      <% const dayStr = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`; %>
      <a class="calendar-cell" href="/tasks/day/<%= dayStr %>">
        <div class="calendar-day"><%= day %></div>
        <% if (tasksByDay[day]) { %>
          <% tasksByDay[day].forEach(t => { %>
            <div class="calendar-task" title="<%= t.assigneeNames %>"><%= t.title %></div>
          <% }) %>
        <% } %>
      </a>
    <% } %>
  </div>
</div>

<script>
  // カンバンのドラッグ&ドロップでステータス変更
  document.querySelectorAll('.kanban-card').forEach(card => {
    card.addEventListener('dragstart', (e) => {
      e.dataTransfer.setData('text/plain', card.dataset.id);
    });
  });

  document.querySelectorAll('.kanban-list').forEach(list => {
    list.addEventListener('dragover', (e) => e.preventDefault());
    list.addEventListener('drop', async (e) => {
      e.preventDefault();
      const id = e.dataTransfer.getData('text/plain');
      const status = list.dataset.status;
      await fetch('/tasks/' + id + '/status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'fetch',
        },
        body: 'status=' + status,
      });
      window.location.reload();
    });
  });
</script>

<%- include('../partials/footer') %>
