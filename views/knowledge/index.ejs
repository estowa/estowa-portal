<%- include('../partials/header') %>

<div class="page-header">
  <h1>ナレッジ共有</h1>
  <a href="/knowledge/new" style="padding:8px 16px; background:var(--primary); color:white; border-radius:6px; font-size:13px; white-space:nowrap; height:fit-content;">+ 新規記事</a>
</div>

<div class="panel">
  <form method="GET" action="/knowledge" class="form-inline" style="margin-bottom:14px;">
    <input type="text" name="q" placeholder="キーワード検索" value="<%= q %>" style="min-width:200px;" />
    <button type="submit">検索</button>
  </form>

  <div class="form-inline" style="margin-bottom:14px;">
    <span style="font-size:13px; color:var(--text-muted);">カテゴリ:</span>
    <a href="/knowledge" class="mini-btn <%= !categoryFilter ? 'active-filter' : '' %>">すべて</a>
    <% categories.forEach(c => { %>
      <a href="/knowledge?category=<%= encodeURIComponent(c) %>" class="badge" style="background: <%= colorForCategory(c) %>; color: white; <%= categoryFilter === c ? 'outline:2px solid var(--text);' : '' %>"><%= c %></a>
    <% }) %>
  </div>

  <% if (articles.length === 0) { %>
    <div class="empty-note">該当する記事はありません</div>
  <% } else { %>
    <% articles.forEach(a => { %>
      <div class="announcement-item">
        <a href="/knowledge/<%= a.id %>" class="knowledge-title-link"><%= a.title %></a>
        <div style="font-size:12px; color:var(--text-muted); margin-top:4px;">
          <% if (a.category) { %><span class="badge" style="background: <%= colorForCategory(a.category) %>; color: white;"><%= a.category %></span> ・ <% } %>
          <%= a.author_name || a.created_by %> ・ 更新: <%= a.updated_at %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
