<%- include('../partials/header') %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
  <div>
    <h1 style="font-size:20px; margin:0 0 6px 0;"><%= article.title %></h1>
    <div style="font-size:12px; color:var(--text-muted);">
      <% if (article.category) { %><span class="badge member"><%= article.category %></span> ・ <% } %>
      <%= article.author_name || article.created_by %> ・ 更新: <%= article.updated_at %>
    </div>
  </div>
  <div class="form-inline">
    <a href="/knowledge/<%= article.id %>/edit" class="mini-btn">編集</a>
    <form method="POST" action="/knowledge/<%= article.id %>/delete" onsubmit="return confirm('この記事を削除しますか？');">
      <button type="submit" class="mini-btn">削除</button>
    </form>
  </div>
</div>

<div class="panel markdown-body">
  <%- bodyHtml %>
</div>

<a href="/knowledge" style="font-size:13px; color:var(--text-muted);">← 一覧に戻る</a>

<%- include('../partials/footer') %>
