<%- include('../partials/header') %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
  <div>
    <h1 style="font-size:20px; margin:0 0 6px 0;"><%= article.title %></h1>
    <div style="font-size:12px; color:var(--text-muted);">
      <% if (article.category) { %><span class="badge" style="background: <%= colorForCategory(article.category) %>; color: white;"><%= article.category %></span> ・ <% } %>
      <%= article.author_name || article.created_by %> ・ 更新: <%= article.updated_at %>
    </div>
  </div>
  <div class="form-inline">
    <a href="/knowledge/<%= article.id %>/edit" class="mini-btn">編集</a>
    <form method="POST" action="/knowledge/<%= article.id %>/delete" onsubmit="return confirm('この記事を削除しますか？');">
      <button type="submit" class="mini-btn">削除</button>
    </form>
  </div>
</div>

<div class="panel markdown-body">
  <%- bodyHtml %>

  <% if (article.attachments && article.attachments.length > 0) { %>
    <div class="file-list" style="margin-top:14px; margin-bottom:0;">
      <% article.attachments.forEach(att => { %>
        <div class="file-list-item">
          <span class="file-icon">📄</span>
          <a href="/uploads/knowledge/<%= att.filename %>" target="_blank" rel="noopener" class="file-name" title="<%= att.original_name %>"><%= att.original_name %></a>
          <a href="/uploads/knowledge/<%= att.filename %>" download="<%= att.original_name %>" class="file-download-link">ダウンロード</a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<a href="/knowledge" style="font-size:13px; color:var(--text-muted);">← 一覧に戻る</a>

<%- include('../partials/footer') %>
