<%- include('../partials/header') %>

<h1 style="font-size:18px; margin-bottom:16px;"><%= article && article.id ? '記事を編集' : '新規記事作成' %></h1>

<% if (attachments && attachments.length > 0) { %>
  <div class="panel">
    <label style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:4px;">添付ファイル</label>
    <div class="file-list">
      <% attachments.forEach(a => { %>
        <div class="file-list-item">
          <span class="file-icon">📄</span>
          <a href="/uploads/knowledge/<%= a.filename %>" target="_blank" rel="noopener" class="file-name" title="<%= a.original_name %>"><%= a.original_name %></a>
          <a href="/uploads/knowledge/<%= a.filename %>" download="<%= a.original_name %>" class="file-download-link">ダウンロード</a>
          <form method="POST" action="/knowledge/<%= article.id %>/attachments/<%= a.id %>/delete" onsubmit="return confirm('このファイルを削除しますか？');">
            <button type="submit" class="mini-btn">削除</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="panel">
  <% if (error) { %><div class="error-text"><%= error %></div><% } %>
  <% if (uploadError) { %><div class="error-text"><%= uploadError %></div><% } %>
  <form method="POST" action="<%= article && article.id ? '/knowledge/' + article.id : '/knowledge' %>" enctype="multipart/form-data">
    <input type="text" name="title" placeholder="タイトル" required value="<%= article ? article.title : '' %>"
      style="width:100%; padding:10px; margin-bottom:8px; border:1px solid var(--border); border-radius:8px;" />

    <label style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:2px;">カテゴリ</label>
    <select name="category" style="width:100%; padding:10px; margin-bottom:8px; border:1px solid var(--border); border-radius:8px;">
      <% categoryDefs.forEach(([name]) => { %>
        <option value="<%= name %>" <%= article && article.category === name ? 'selected' : '' %>><%= name %></option>
      <% }) %>
    </select>

    <label style="font-size:13px; color:var(--text-muted); display:block; margin-bottom:4px;">本文</label>
    <div class="kb-toolbar" id="kb-toolbar">
      <button type="button" data-act="heading" title="大見出し">見出し</button>
      <button type="button" data-act="sub" title="小見出し">小見出し</button>
      <button type="button" data-act="bold" title="太字"><b>太字</b></button>
      <button type="button" data-act="ul" title="箇条書き">箇条書き</button>
      <button type="button" data-act="ol" title="番号リスト">番号リスト</button>
      <button type="button" data-act="table" title="表を入れる">表</button>
      <button type="button" data-act="link" title="リンクを入れる">リンク</button>
      <span class="kb-toolbar-sep"></span>
      <button type="button" data-act="callout" data-name="重要" class="kb-btn-important" title="赤い枠">重要</button>
      <button type="button" data-act="callout" data-name="注意" class="kb-btn-caution" title="黄色い枠">注意</button>
      <button type="button" data-act="callout" data-name="ポイント" class="kb-btn-point" title="青い枠">ポイント</button>
      <button type="button" data-act="callout" data-name="メモ" class="kb-btn-memo" title="グレーの枠">メモ</button>
      <button type="button" id="kb-preview-toggle" class="kb-preview-btn" aria-pressed="false">プレビュー</button>
    </div>
    <div class="kb-hint">文字を選んでからボタンを押すと、その部分に効きます。保存の前に「プレビュー」で見え方を確認できます。</div>
    <textarea name="body" id="kb-body" placeholder="本文を入力" rows="16"
      style="width:100%; padding:10px; margin-bottom:8px; border:1px solid var(--border); border-radius:8px; font-family:monospace; font-size:14px;"><%= article ? article.body : '' %></textarea>
    <div id="kb-preview" class="markdown-body kb-preview" hidden></div>

    <label style="font-size:13px; color:var(--text-muted); display:block; margin:8px 0 4px;">ファイルを追加（任意・複数枚OK）</label>
    <div class="dropzone" style="margin-bottom:16px;">
      <input type="file" name="files" multiple />
      <div>ここにファイルをドラッグ&ドロップ<br />またはクリックして選択</div>
      <div class="dropzone-filelist"></div>
    </div>

    <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">保存</button>
    <a href="/knowledge" style="margin-left:10px; font-size:13px; color:var(--text-muted);">キャンセル</a>
  </form>
</div>

<script src="/js/dropzone.js"></script>
<script src="/js/knowledge-editor.js"></script>
<%- include('../partials/footer') %>
