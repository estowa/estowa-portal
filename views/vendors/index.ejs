<%- include('../partials/header') %>

<h1 style="font-size:18px; margin-bottom:16px;">外注先リスト</h1>

<div class="panel">
  <h2>新規登録</h2>
  <form method="POST" action="/vendors" class="form-inline">
    <input type="text" name="category" placeholder="カテゴリ（例: 印刷）" style="width:140px;" />
    <input type="text" name="name" placeholder="外注先名" required style="min-width:160px;" />
    <input type="text" name="contact_info" placeholder="連絡先（電話・メール等）" style="min-width:200px;" />
    <input type="text" name="notes" placeholder="備考" style="min-width:160px;" />
    <button type="submit">追加</button>
  </form>
</div>

<div class="panel">
  <div class="form-inline" style="margin-bottom:14px;">
    <span style="font-size:13px; color:var(--text-muted);">カテゴリで絞り込み:</span>
    <a href="/vendors" class="mini-btn <%= !categoryFilter ? 'active-filter' : '' %>">すべて</a>
    <% categories.forEach(c => { %>
      <a href="/vendors?category=<%= encodeURIComponent(c) %>" class="mini-btn <%= categoryFilter === c ? 'active-filter' : '' %>"><%= c %></a>
    <% }) %>
  </div>

  <table class="user-table">
    <thead>
      <tr>
        <th>カテゴリ</th>
        <th>外注先名</th>
        <th>連絡先</th>
        <th>備考</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% vendors.forEach(v => { %>
        <tr>
          <td><%= v.category || '-' %></td>
          <td><%= v.name %></td>
          <td><%= v.contact_info || '-' %></td>
          <td><%= v.notes || '-' %></td>
          <td>
            <form method="POST" action="/vendors/<%= v.id %>/delete" onsubmit="return confirm('削除しますか？');">
              <button type="submit" class="mini-btn">削除</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (vendors.length === 0) { %>
        <tr><td colspan="5" class="empty-note">登録されている外注先はありません</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
