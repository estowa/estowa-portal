<%- include('../partials/header') %>

<div class="page-header">
  <h1>外注先リスト</h1>
  <a href="/vendors/new" class="new-toggle-btn">+ 新規登録</a>
</div>

<% groups.forEach(group => { %>
  <div class="panel vendor-category-panel">
    <div class="vendor-category-head">
      <span class="badge" style="background: <%= group.color %>; color: white;"><%= group.name %></span>
      <span class="vendor-category-count">(<%= group.vendors.length %>)</span>
      <a href="/vendors/new?category=<%= encodeURIComponent(group.name) %>" class="mini-btn" style="margin-left:auto;">+ 追加</a>
    </div>

    <% if (group.vendors.length === 0) { %>
      <div class="empty-note">登録されている外注先はありません</div>
    <% } else { %>
      <table class="user-table">
        <thead>
          <tr>
            <th>社名</th>
            <th>URL</th>
            <th>用途</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% group.vendors.forEach(v => { %>
            <tr>
              <td><%= v.name %></td>
              <td>
                <% if (v.url) { %>
                  <a href="<%= /^https?:\/\//.test(v.url) ? v.url : 'https://' + v.url %>" target="_blank" rel="noopener"><%= v.url %></a>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td><%= v.notes || '-' %></td>
              <td>
                <form method="POST" action="/vendors/<%= v.id %>/delete" onsubmit="return confirm('削除しますか？');">
                  <button type="submit" class="mini-btn">削除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/footer') %>
