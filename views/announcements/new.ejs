<%- include('../partials/header') %>

<div class="page-header">
  <h1>新規お知らせ投稿</h1>
  <a href="/announcements" class="mini-btn">← 一覧に戻る</a>
</div>

<div class="content-grid">
  <div>
    <div class="panel">
      <% if (error) { %><div class="error-text"><%= error %></div><% } %>
      <form method="POST" action="/announcements" enctype="multipart/form-data">
        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">タイトル</label>
        <input type="text" name="title" required
          style="width:100%; padding:10px; margin-bottom:10px; border:1px solid var(--border); border-radius:8px;" />

        <label style="font-size:12px; color:var(--text-muted); display:block; margin-bottom:2px;">本文（任意）</label>
        <textarea name="body" rows="6" placeholder="お知らせの内容"
          style="width:100%; padding:10px; margin-bottom:10px; border:1px solid var(--border); border-radius:8px; font-family:inherit; font-size:14px; resize:vertical;"></textarea>

        <label style="font-size:12px; color:var(--text-muted); display:block; margin:8px 0 4px;">ファイル添付（任意・複数枚OK）</label>
        <div class="dropzone" style="margin-bottom:16px;">
          <input type="file" name="files" multiple />
          <div>ここにファイルをドラッグ&ドロップ<br />またはクリックして選択</div>
          <div class="dropzone-filelist"></div>
        </div>

        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">投稿する</button>
      </form>
    </div>
  </div>
</div>

<script src="/js/dropzone.js"></script>
<%- include('../partials/footer') %>
