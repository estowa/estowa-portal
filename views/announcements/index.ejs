<%- include('../partials/header') %>

<div class="page-header">
  <h1>お知らせ</h1>
  <% if (currentUser && currentUser.role === 'admin') { %>
    <a href="/announcements/new" class="new-toggle-btn">+ 新規お知らせ</a>
  <% } %>
</div>

<div class="panel">
  <% if (announcements.length === 0) { %>
    <div class="empty-note">お知らせはまだありません</div>
  <% } else { %>
    <div class="announcement-list">
      <% announcements.forEach(a => { %>
        <a href="/announcements/<%= a.id %>" class="announcement-row <%= a.is_read ? 'is-read' : 'is-unread' %>">
          <span class="announcement-row-main">
            <% if (!a.is_read) { %><span class="unread-dot" title="未読"></span><% } %>
            <span class="announcement-row-title"><%= a.title %></span>
          </span>
          <span class="announcement-row-meta">
            <%- include('../partials/avatar', { avatar: a.authorAvatar, size: 'xs' }) %>
            <span class="announcement-row-date"><%= a.created_at %></span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
