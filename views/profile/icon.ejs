<%- include('../partials/header') %>

<div class="page-header">
  <h1>自分のアイコン設定</h1>
  <a href="/tasks" class="mini-btn">← タスク管理に戻る</a>
</div>

<div class="content-grid">
  <div>
    <div class="panel">
      <% if (success) { %><div style="color:var(--green); font-size:13px; margin-bottom:10px;"><%= success %></div><% } %>
      <p style="font-size:13px; color:var(--text-muted); margin-bottom:14px;">
        タスク一覧やお知らせで表示されるアイコンです。好きな絵文字と色を選んで保存してください。
      </p>

      <div class="icon-preview-row">
        <span class="avatar avatar-lg" id="iconPreview" style="background: <%= avatar.color %>;">
          <%= avatar.emoji || avatar.initial %>
        </span>
        <div>
          <div style="font-weight:600;"><%= profileUser.display_name %></div>
          <div style="font-size:12px; color:var(--text-muted);">プレビュー</div>
        </div>
      </div>

      <form method="POST" action="/profile/icon">
        <div class="icon-picker-section">
          <h3>絵文字（未選択の場合は名前の頭文字が表示されます）</h3>
          <div class="icon-picker-grid" id="emojiGrid">
            <label class="icon-option <%= !avatar.emoji ? 'selected' : '' %>" data-emoji-option="">
              <input type="radio" name="avatar_emoji" value="" style="display:none;" <%= !avatar.emoji ? 'checked' : '' %> />
              <%= avatar.initial %>
            </label>
            <% emojiOptions.forEach(e => { %>
              <label class="icon-option <%= avatar.emoji === e ? 'selected' : '' %>" data-emoji-option="<%= e %>">
                <input type="radio" name="avatar_emoji" value="<%= e %>" style="display:none;" <%= avatar.emoji === e ? 'checked' : '' %> />
                <%= e %>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="icon-picker-section">
          <h3>背景色</h3>
          <div class="icon-picker-grid" id="colorGrid">
            <% colorOptions.forEach(c => { %>
              <label class="color-option <%= avatar.color === c ? 'selected' : '' %>" style="background: <%= c %>;" data-color-option="<%= c %>">
                <input type="radio" name="avatar_color" value="<%= c %>" style="display:none;" <%= avatar.color === c ? 'checked' : '' %> />
              </label>
            <% }) %>
          </div>
        </div>

        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">保存する</button>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    const preview = document.getElementById('iconPreview');
    const initial = <%- JSON.stringify(avatar.initial) %>;

    document.getElementById('emojiGrid').addEventListener('click', (e) => {
      const opt = e.target.closest('[data-emoji-option]');
      if (!opt) return;
      document.querySelectorAll('#emojiGrid .icon-option').forEach((el) => el.classList.remove('selected'));
      opt.classList.add('selected');
      opt.querySelector('input').checked = true;
      const emoji = opt.dataset.emojiOption;
      preview.textContent = emoji || initial;
    });

    document.getElementById('colorGrid').addEventListener('click', (e) => {
      const opt = e.target.closest('[data-color-option]');
      if (!opt) return;
      document.querySelectorAll('#colorGrid .color-option').forEach((el) => el.classList.remove('selected'));
      opt.classList.add('selected');
      opt.querySelector('input').checked = true;
      preview.style.background = opt.dataset.colorOption;
    });
  })();
</script>

<%- include('../partials/footer') %>
