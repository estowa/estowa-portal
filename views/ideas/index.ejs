<%- include('../partials/header') %>

<div class="page-header">
  <h1>アイディア</h1>
  <a href="/ideas/new" class="new-toggle-btn">+ 新規アイディア</a>
</div>

<div class="panel">
  <form method="GET" action="/ideas" class="form-inline" style="margin-bottom:14px;">
    <input type="text" name="q" placeholder="キーワード検索" value="<%= q %>" style="min-width:200px;" />
    <button type="submit">検索</button>
  </form>

  <div class="form-inline" style="margin-bottom:14px;">
    <span style="font-size:13px; color:var(--text-muted);">カテゴリ:</span>
    <a href="/ideas" class="mini-btn <%= !categoryFilter ? 'active-filter' : '' %>">すべて</a>
    <% categories.forEach(c => { %>
      <a href="/ideas?category=<%= encodeURIComponent(c) %>" class="badge" style="background: <%= colorForCategory(c) %>; color: white; <%= categoryFilter === c ? 'outline:2px solid var(--text);' : '' %>"><%= c %></a>
    <% }) %>
  </div>

  <% if (ideas.length === 0) { %>
    <div class="empty-note">該当するアイディアはありません</div>
  <% } else { %>
    <% ideas.forEach(i => { %>
      <div class="announcement-item">
        <a href="/ideas/<%= i.id %>" class="link-title"><%= i.title %></a>
        <div style="font-size:12px; color:var(--text-muted); margin-top:4px;">
          <% if (i.category) { %><span class="badge" style="background: <%= colorForCategory(i.category) %>; color: white;"><%= i.category %></span> ・ <% } %>
          <%= i.author_name || i.created_by %> ・ 更新: <%= formatJst(i.updated_at) %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
