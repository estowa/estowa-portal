<%- include('../partials/header') %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
  <div>
    <h1 style="font-size:20px; margin:0 0 6px 0;"><%= idea.title %></h1>
    <div style="font-size:12px; color:var(--text-muted);">
      <% if (idea.category) { %><span class="badge" style="background: <%= colorForCategory(idea.category) %>; color: white;"><%= idea.category %></span> ・ <% } %>
      <%= idea.author_name || idea.created_by %> ・ 更新: <%= formatJst(idea.updated_at) %>
    </div>
  </div>
  <div class="form-inline">
    <a href="/ideas/<%= idea.id %>/edit" class="mini-btn">編集</a>
    <form method="POST" action="/ideas/<%= idea.id %>/delete" onsubmit="return confirm('このアイディアを削除しますか？元に戻せません。');">
      <button type="submit" class="mini-btn">削除</button>
    </form>
  </div>
</div>

<div class="panel markdown-body">
  <% if (toc && toc.length > 0) { %>
    <nav class="kb-toc">
      <div class="kb-toc-title">目次</div>
      <ul>
        <% toc.forEach(t => { %><li class="toc-l<%= t.level %>"><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %>
      </ul>
    </nav>
  <% } %>
  <%- bodyHtml %>

  <% if (idea.attachments && idea.attachments.length > 0) { %>
    <div class="file-list" style="margin-top:14px; margin-bottom:0;">
      <% idea.attachments.forEach(att => { %>
        <div class="file-list-item">
          <span class="file-icon">📄</span>
          <a href="/uploads/ideas/<%= att.filename %>" target="_blank" rel="noopener" class="file-name" title="<%= att.original_name %>"><%= att.original_name %></a>
          <a href="/uploads/ideas/<%= att.filename %>" download="<%= att.original_name %>" class="file-download-link">ダウンロード</a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<a href="/ideas" style="font-size:13px; color:var(--text-muted);">← 一覧に戻る</a>

<%- include('../partials/footer') %>
