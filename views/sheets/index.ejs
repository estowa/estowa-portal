<%- include('../partials/header') %>

<div class="page-header">
  <h1>表計算</h1>
  <details class="new-toggle">
    <summary>+ 新規シート</summary>
    <div class="new-form-panel">
      <h2>新規シート作成</h2>
      <form method="POST" action="/sheets">
        <input type="text" name="name" placeholder="シート名（例: 2026年9月経費）" required />
        <button type="submit" style="padding:8px 16px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">作成</button>
      </form>
    </div>
  </details>
</div>

<div class="panel">
  <% if (sheets.length === 0) { %>
    <div class="empty-note">シートはまだありません</div>
  <% } else { %>
    <table class="user-table">
      <thead><tr><th>シート名</th><th>最終更新</th><th></th></tr></thead>
      <tbody>
        <% sheets.forEach(s => { %>
          <tr>
            <td><a href="/sheets/<%= s.id %>" style="color:var(--primary); font-weight:600;"><%= s.name %></a></td>
            <td><%= s.updated_at %></td>
            <td>
              <form method="POST" action="/sheets/<%= s.id %>/delete" onsubmit="return confirm('このシートを削除しますか？');">
                <button type="submit" class="mini-btn">削除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
