<%- include('../partials/header') %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
  <h1 style="font-size:18px; margin:0;"><%= sheet.name %></h1>
  <div class="form-inline">
    <form method="POST" action="/sheets/<%= sheet.id %>/add-row"><button type="submit" class="mini-btn">+ 行を追加</button></form>
    <form method="POST" action="/sheets/<%= sheet.id %>/add-col"><button type="submit" class="mini-btn">+ 列を追加</button></form>
    <a href="/sheets/<%= sheet.id %>/export" class="mini-btn">エクセルをエクスポート</a>
    <form method="POST" action="/sheets/<%= sheet.id %>/import" enctype="multipart/form-data" onsubmit="return confirm('現在のシート内容をエクセルの内容で上書きします。よろしいですか？');" style="display:flex; align-items:center; gap:6px;">
      <input type="file" name="excel_file" accept=".xlsx,.xls" required style="max-width:180px;" />
      <button type="submit" class="mini-btn">インポート</button>
    </form>
    <a href="/sheets" class="mini-btn">一覧に戻る</a>
  </div>
</div>

<div class="panel">
  <h2>編集（セルの先頭に「=」を付けると計算式になります。例: =A1+B1 / =SUM(A1:A5)）</h2>
  <form method="POST" action="/sheets/<%= sheet.id %>">
    <div style="overflow-x:auto;">
      <table class="sheet-table">
        <thead>
          <tr>
            <th></th>
            <% colLabels.forEach(label => { %><th><%= label %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% for (let r = 0; r < grid.rows; r++) { %>
            <tr>
              <th><%= r + 1 %></th>
              <% for (let c = 0; c < grid.cols; c++) { %>
                <td>
                  <input type="text" name="cell_<%= r %>_<%= c %>" value="<%= grid.cells[r][c] || '' %>" />
                </td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <button type="submit" style="margin-top:12px; padding:8px 20px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">保存</button>
  </form>
</div>

<div class="panel">
  <h2>計算結果</h2>
  <div style="overflow-x:auto;">
    <table class="sheet-table readonly">
      <thead>
        <tr>
          <th></th>
          <% colLabels.forEach(label => { %><th><%= label %></th><% }) %>
        </tr>
      </thead>
      <tbody>
        <% computed.forEach((row, r) => { %>
          <tr>
            <th><%= r + 1 %></th>
            <% row.forEach(val => { %>
              <td><%= typeof val === 'number' ? val.toLocaleString() : val %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
